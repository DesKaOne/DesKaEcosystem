# DigiFlazz Buyer API credentials.
# Never commit real credentials.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

# Optional DigiFlazz endpoint overrides for local tests.
DIGIFLAZZ_ENDPOINT=https://api.digiflazz.com/v1/transaction
DIGIFLAZZ_BALANCE_ENDPOINT=https://api.digiflazz.com/v1/cek-saldo
# Product price-list cache is enabled by the runtime with a 15 minute TTL.

# DesKaProvider operational runtime.
# The JSON store is an interim v0.1 single-process persistence boundary.
DESKAPROVIDER_OPERATIONAL_STORE_PATH=data/operational-snapshots.json
DESKAPROVIDER_OPERATIONAL_CURRENCY=IDR
DESKAPROVIDER_BALANCE_SYNC_INTERVAL=30s
DESKAPROVIDER_BALANCE_FAILURE_THRESHOLD=3
