# DigiFlazz Buyer API credentials.
# Never commit real credentials.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com
DIGIFLAZZ_HTTP_TIMEOUT=15s
DIGIFLAZZ_ENDPOINT=https://api.digiflazz.com/v1/transaction
DIGIFLAZZ_BALANCE_ENDPOINT=https://api.digiflazz.com/v1/cek-saldoDIGIFLAZZ_PRICE_LIST_ENDPOINT=https://api.digiflazz.com/v1/price-list
# Credential-gated validation; keep disabled in normal CI.
DIGIFLAZZ_INTEGRATION=0
# Optional fixed ref_id for the official DigiFlazz CS test tuple; leave empty for generated IDs.
DIGIFLAZZ_INTEGRATION_REFERENCE_ID=

# Midtrans Snap/Core API credentials.
# Never commit the real server key.
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_ENDPOINT=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_API_ENDPOINT=https://api.sandbox.midtrans.com

# IAK prepaid API credentials.
# Runtime registers IAK only when either IAK variable is set; both are then required.
IAK_USERNAME=
IAK_API_KEY=
IAK_BASE_URL=https://prepaid.iak.id
IAK_PRICE_LIST_ENDPOINT=https://prepaid.iak.id/api/pricelist
IAK_INQUIRY_PLN_ENDPOINT=https://prepaid.iak.id/api/inquiry-pln
IAK_TOP_UP_ENDPOINT=https://prepaid.iak.id/api/top-up
IAK_STATUS_ENDPOINT=https://prepaid.iak.id/api/check-status
IAK_BALANCE_ENDPOINT=https://prepaid.iak.id/api/check-balance

DESKAPROVIDER_OPERATIONAL_STORE_PATH=data/operational-snapshots.json
# Explicitly select json or postgres. postgres never falls back to json.
DESKAPROVIDER_OPERATIONAL_STORE_DRIVER=json
# PostgreSQL schema mode: check (default) or migrate (explicit startup migration).
DESKAPROVIDER_POSTGRES_SCHEMA_MODE=check
DESKAPROVIDER_OPERATIONAL_CURRENCY=IDR
DESKAPROVIDER_BALANCE_SYNC_INTERVAL=30s
DESKAPROVIDER_BALANCE_FAILURE_THRESHOLD=3
DESKAPROVIDER_TRANSACTION_STORE_PATH=data/provider-transactions.json
DESKAPROVIDER_TRANSACTION_STORE_DRIVER=json
DESKAPROVIDER_AUDIT_STORE_DRIVER=memory
DESKAPROVIDER_POSTGRES_DSN=

DESKAPROVIDER_CATALOG_STORE_PATH=data/product-catalog.json
DESKAPROVIDER_CATALOG_SYNC_INTERVAL=15m
DESKAPROVIDER_CATALOG_MAX_AGE=30m

DESKAPROVIDER_CATALOG_SYNC_STATUS_STORE_PATH=data/catalog-sync-status.json

# Optional live/sandbox integration gate. Normal CI remains disabled and credential-free.
DESKAPROVIDER_LIVE_INTEGRATION=0
DESKAPROVIDER_LIVE_INTEGRATION_PROVIDER=midtrans
# Explicit host allowlist; only HTTPS endpoints on these hosts are accepted.
DESKAPROVIDER_LIVE_INTEGRATION_ALLOWED_HOSTS=app.sandbox.midtrans.com,api.sandbox.midtrans.com,api.digiflazz.com
# IAK read-only validation is opt-in and must never share a provider gate with Midtrans.
IAK_INTEGRATION=0
# XP SINDONESIA read-only balance validation is opt-in and provider-gated.
XP_SINDONESIA_CALLBACK_URL=
XP_SINDONESIA_INTEGRATION=0
# Optional deterministic order id override for authorized sandbox validation.
MIDTRANS_INTEGRATION_ORDER_ID=
